{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$9+$2#$9:\n $2#$1@$9:\n  $2##\n   $9+$1@$9:\n    $9:$1@$9+\n     $9:$1@$2+          $9::+++:\n      $9:$3#$1#$9:  :++$2++$9+$2#$1@@@$9+:+$2+#$3@$1@@@$2##$9+\n       $9:$6#$3#$2#$1#@@@@@@$2#$1@@$2#$4#$2####$1@@#@$2#$9+\n        $9+$1@@@#$2######$1##@#$2#$1#@@#$2######$9+:\n        $9:$2###+$1####$2#####$1@@@@@$9+:$2##$1#@@#$9+\n        $9:$1###@$2#$1##$2###$1#@@$2###$9+::$8#$9+:+$2##$9:\n         $9:$4#$9+:$2#$9:$2#+$1###$2##+$4@$1#$9:$8##$9+$8#$7@$8##$9+:\n               $9::$2####$9+$2#$9+:$8#@$7@$8@$9+$8#$7@@@@$8+\n           $9+$4@$9::$4@$2##$4@@$2#$4@$2#$8#@$7@@@@$8#$9:$7@$8##$9+\n          $9+$4@@@$5@@$4@$9+$2#$9+   +$8##@$7@@$8##$7@@$8#\n          $4#$5@@@@$2#$9:        +$8#$7@@$8@$9+$7@@$8#\n          $6@#$4@@$2#           $9:$8@$7@@$9+$8#$7@$9:\n         $9:$6@#$4@$2#             $9+$7@@$8###\n         $9+$6#$9+::             :$8+$9++$8#$9:\n                               $8+$9:\n",
    "color": {
      "1": "#915ADA",
      "2": "#602EB3",
      "3": "#A071DF",
      "4": "#7B89EC",
      "5": "#98A4F8",
      "6": "#99E550",
      "7": "#DF9326",
      "8": "#C67F19",
      "9": "#342541"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  :  ",
    "color": {
      "keys": "#995CD0",
      "title": "#8EDF5F",
      "output": "#ECDCFF",
      "separator": "#62C77B"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{##8EDF5F}\u250c\u2500 EVA-01 / SYSTEM STATUS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510"
    },
    "title",
    "break",
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "host",
      "key": "Host"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "display",
      "key": "Display"
    },
    {
      "type": "de",
      "key": "Desktop"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#62C77B"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#62C77B"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "#62C77B"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "#62C77B"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "#62C77B"
    },
    {
      "type": "custom",
      "format": "{##8EDF5F}\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518"
    },
    {
      "type": "custom",
      "format": "{##995CD0}\u25cf {##8EDF5F}\u25cf {##62C77B}\u25cf {##ECDCFF}\u25cf {##B59AD9}\u25cf {##E9A23B}\u25cf {##F07891}\u25cf {##A8BFFF}\u25cf"
